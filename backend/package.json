{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "prisma": {
        "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
