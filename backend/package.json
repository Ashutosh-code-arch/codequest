{
    "name": "codequest-backend",
    "version": "1.0.3",
    "private": true,
    "description": "API and realtime collaboration server for CodeQuest",
    "main": "dist/server.js",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
        "prebuild": "npm run db:generate",
        "build": "tsc",
        "start": "prisma migrate deploy && node dist/server.js",
        "pretypecheck": "npm run db:generate",
        "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
        "test": "npm run build && node --test tests/*.test.js",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "keywords": [
        "collaborative-coding",
        "socket.io",
        "yjs",
        "webrtc",
        "judge0"
    ],
    "author": "Ashutosh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ashutosh-code-arch/codequest.git"
    },
    "homepage": "https://codequest-mu-three.vercel.app",
    "bugs": {
        "url": "https://github.com/Ashutosh-code-arch/codequest/issues"
    },
    "overrides": {
        "deepmerge-ts": "8.0.2"
    },
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.0.6",
        "express-rate-limit": "^8.3.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "lib0": "^0.2.117",
        "pino": "^10.3.1",
        "prisma": "^6.19.3",
        "socket.io": "^4.8.3",
        "y-protocols": "^1.0.7",
        "yjs": "^13.6.30",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.12.2",
        "pino-pretty": "^13.1.3",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3"
    }
}
