        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.0.6",
        "express-rate-limit": "^8.3.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "lib0": "^0.2.117",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^6.19.2",
        "redis": "^5.12.1",
        "socket.io": "^4.8.3",
